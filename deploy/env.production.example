# ============================================================
# 生产环境变量模板
# 复制为 server/.env 后按注释填写；不要提交到版本库
# ============================================================

# 必填：生产环境缺失会直接拒绝启动
# 生成方式：openssl rand -hex 32
JWT_SECRET=请替换为64位随机字符串

# 可选：COS 密钥密文的解密密钥（内容 = server/data/.cos-secret）
# 数据库里存的 SecretId/SecretKey 是 AES-256-GCM 密文，
# 换了这把密钥就解不开，后台会显示「对象存储未配置」。
# 不填则自动生成到 server/data/.cos-secret（首次启动时），迁移时记得一起带走。
COS_ENC_KEY=请替换为data/.cos-secret的内容

# 运行模式：必须是 production（否则 JWT_SECRET 允许缺省、错误信息也会外泄）
NODE_ENV=production

# 服务端口（Nginx 反代到这里，外网不要放行）
PORT=3001

# 监听地址：放在 Nginx 后面时建议 127.0.0.1，只允许本机访问
HOST=127.0.0.1

# 登录 token 有效期
JWT_EXPIRES_IN=24h

# 允许的浏览器来源，多个用英文逗号分隔
# 前端与 API 同域，浏览器实际不会触发跨域；主要是电脑端 Electron 用
CORS_ORIGIN=https://nav.example.com

# JSON 请求体上限（导入含 base64 图标时需要）
JSON_BODY_LIMIT=10mb

# 部署在 Nginx 反向代理后面，必须为 1，否则限流拿不到真实 IP
TRUST_PROXY=1

# 相册在对象存储里的根目录（可选，默认 albums）
COS_ALBUM_PREFIX=albums
