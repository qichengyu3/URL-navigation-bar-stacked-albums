# 复制为 server/.env 后填写真实值（不要提交到版本库）

# 必填（生产环境缺失会拒绝启动）
JWT_SECRET=请替换为至少32位的随机字符串

# 可选
# 登录 token 有效期，默认 24h
JWT_EXPIRES_IN=24h
# 服务端口，默认 3001
PORT=3001
# CORS 允许的来源，生产环境建议写成具体域名，如 https://nav.example.com
CORS_ORIGIN=*
# JSON 请求体上限（导入含 base64 图标时可能需要调大）
JSON_BODY_LIMIT=10mb

# 仅初始化时使用：管理员用户名与初始密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
# 提示：首次登录后请立刻用 `npm run set-password` 改成自己的密码

# 相册在对象存储里的根目录（可选，默认 albums）
COS_ALBUM_PREFIX=albums
